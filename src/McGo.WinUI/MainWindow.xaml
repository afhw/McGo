<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="McGo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="McGo"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="ThemeBackgroundImage" Grid.RowSpan="2" Opacity="0.24" Stretch="UniformToFill" Visibility="Collapsed" />

        <TitleBar
            x:Name="AppTitleBar"
            Title="McGo"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="640"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1280"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="212"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneHeader>
                <Grid Margin="4,4,0,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource McgoAccentSoftBrush}" CornerRadius="9">
                        <Image Width="22" Height="22" Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="McGo" />
                        <TextBlock x:Name="PaneVersionText" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Minecraft 启动器" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="启动" Tag="launch">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DownloadNavItem" Content="下载" Tag="download">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="资源" Tag="resources">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="整合包" Tag="modpacks">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="联机" Tag="online">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="账号" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="DirectoryToolbar" Padding="24,8,24,4" ColumnSpacing="8"
                      SizeChanged="DirectoryToolbar_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DirectoryToolbarLabel" Text="游戏目录" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ActiveGameDirectoryBox" Grid.Column="1" MinWidth="0" Height="32"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="当前游戏目录"
                              SelectionChanged="ActiveGameDirectoryChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" VerticalAlignment="Center" Width="32" Height="32" MinWidth="0" Padding="0"
                            Click="ManageGameDirectories" ToolTipService.ToolTip="管理游戏目录"
                            AutomationProperties.Name="管理游戏目录">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </Button>
                    <Button x:Name="GlobalDownloadTaskButton" Grid.Column="4" MinWidth="0" Height="32"
                            VerticalAlignment="Center" Click="OpenGlobalDownloadTasks"
                            Style="{StaticResource McgoSecondaryButtonStyle}"
                            ToolTipService.ToolTip="打开全局下载任务" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Download" />
                            <TextBlock x:Name="GlobalDownloadTaskText" MaxWidth="150" VerticalAlignment="Center"
                                       Text="下载任务" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Frame x:Name="NavFrame" Grid.Row="1" Navigated="NavFrame_Navigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
