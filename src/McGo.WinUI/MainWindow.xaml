<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="McGo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="McGo"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="ThemeBackgroundImage" Grid.RowSpan="2" Opacity="0.24" Stretch="UniformToFill" Visibility="Collapsed" />

        <TitleBar
            x:Name="AppTitleBar"
            Title="McGo"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="640"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1010"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="212"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF2E4A75" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF365688" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FF3D6199" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundChecked" Color="#FF2E4A75" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedPointerOver" Color="#FF365688" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedPressed" Color="#FF3D6199" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundChecked" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPressed" Color="#FFFFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFD9E7FB" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFCDDFFA" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FFC0D6F8" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundChecked" Color="#FFD9E7FB" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedPointerOver" Color="#FFCDDFFA" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedPressed" Color="#FFC0D6F8" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF0B2E63" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF0B2E63" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF0B2E63" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundChecked" Color="#FF0B2E63" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPointerOver" Color="#FF0B2E63" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPressed" Color="#FF0B2E63" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <Grid Margin="4,4,0,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource McgoAccentSoftBrush}" CornerRadius="9">
                        <Image Width="22" Height="22" Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="McGo" />
                        <TextBlock x:Name="PaneVersionText" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Minecraft 启动器" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="启动" Tag="launch">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DownloadNavItem" Content="下载" Tag="download">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="资源" Tag="resources">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="整合包" Tag="modpacks">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="联机" Tag="online">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="账号" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="NavFrame" />
        </NavigationView>

        <Button
            x:Name="GlobalDownloadTaskButton"
            Grid.Row="1"
            MinWidth="150"
            Height="38"
            Margin="0,0,24,18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="20"
            Click="OpenGlobalDownloadTasks"
            CornerRadius="19"
            Style="{StaticResource McgoPrimaryButtonStyle}"
            ToolTipService.ToolTip="打开全局下载任务"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Download" />
                <TextBlock x:Name="GlobalDownloadTaskText" VerticalAlignment="Center" Text="下载任务" />
            </StackPanel>
        </Button>
    </Grid>
</Window>