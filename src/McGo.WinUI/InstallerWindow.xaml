<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="McGo.WinUI.InstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="McGo 安装程序">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#FF202225" RequestedTheme="Dark">
        <Grid.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="#FF2A2D31" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF303338" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF2A2D31" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF50545A" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF4CC2FF" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="InstallerTitleBar"
            Title="McGo 安装程序"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="28,30"
                Background="#FF181A1D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="16">
                        <Image
                            Width="54"
                            Height="54"
                            HorizontalAlignment="Left"
                            Source="Assets/Square44x44Logo.scale-200.png" />
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="McGo" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="WinUI 3 测试版"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,30,0,0"
                        Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StepOneMarker" Width="24" Height="24" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="1" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="安装选项" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="路径与快捷方式" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StepTwoMarker" Width="24" Height="24" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="2" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="写入文件" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="客户端与系统入口" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StepThreeMarker" Width="24" Height="24" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="3" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="完成" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="启动 McGo" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="2"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="仅包含简体中文资源"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Padding="38,30,38,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="OptionsPanel" MaxWidth="560" HorizontalAlignment="Stretch" Spacing="22">
                    <StackPanel Spacing="7">
                        <TextBlock x:Name="HeadingText" FontSize="30" FontWeight="SemiBold" Text="安装 McGo" />
                        <TextBlock
                            x:Name="DescriptionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="选择安装位置。更新安装会保留已有账号、设置和游戏目录。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathBox" Header="安装位置" />
                        <Button
                            Grid.Column="1"
                            MinWidth="84"
                            VerticalAlignment="Bottom"
                            Click="ChooseInstallDirectory"
                            Content="浏览" />
                    </Grid>

                    <StackPanel Spacing="12">
                        <CheckBox x:Name="DesktopShortcutCheckBox" Content="创建桌面快捷方式" />
                        <CheckBox
                            x:Name="RemoveDataCheckBox"
                            Content="同时删除账号、设置、日志和游戏数据"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <InfoBar
                        x:Name="NoticeBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="测试版，可与稳定版并存。"
                        Severity="Informational" />
                </StackPanel>

                <StackPanel
                    x:Name="ProgressPanel"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="18"
                    Visibility="Collapsed">
                    <TextBlock x:Name="ProgressHeadingText" FontSize="30" FontWeight="SemiBold" Text="正在安装" />
                    <TextBlock x:Name="ProgressStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在准备文件" TextWrapping="Wrap" />
                    <ProgressBar x:Name="InstallProgressBar" Height="6" Maximum="100" />
                    <TextBlock x:Name="ProgressPercentText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="0%" />
                </StackPanel>

                <StackPanel
                    x:Name="CompletePanel"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="18"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" FontSize="42" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="CompleteHeadingText" FontSize="30" FontWeight="SemiBold" Text="安装完成" />
                    <TextBlock x:Name="CompleteDescriptionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="McGo 已准备就绪。" TextWrapping="Wrap" />
                    <CheckBox x:Name="LaunchAfterInstallCheckBox" IsChecked="True" Content="完成后启动 McGo" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,24,0,0" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="VersionText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CancelButton" MinWidth="92" Click="CancelInstaller" Content="取消" />
                        <Button x:Name="PrimaryButton" MinWidth="112" Click="PrimaryAction" Content="安装" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
