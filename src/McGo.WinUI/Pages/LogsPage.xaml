<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24,16,24,28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Style="{StaticResource McgoPageTitleStyle}" Text="日志" />
            <TextBlock Style="{StaticResource McgoPageSubtitleStyle}" Text="查看 McGo 与 Minecraft 的运行记录，用于排查启动与下载问题。" />
        </StackPanel>

        <!--  一行工具栏：选文件 + 刷新 + 打开目录 + 清空  -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="8"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="LogFilesBox"
                HorizontalAlignment="Stretch"
                PlaceholderText="选择日志文件"
                SelectionChanged="LogFileChanged" />
            <Button
                Grid.Column="1"
                Click="RefreshLogs"
                Style="{StaticResource McgoSecondaryButtonStyle}"
                ToolTipService.ToolTip="刷新日志列表并重新读取当前日志">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Click="OpenLogsFolder"
                Style="{StaticResource McgoSecondaryButtonStyle}"
                ToolTipService.ToolTip="打开日志所在目录">
                <SymbolIcon Symbol="Folder" />
            </Button>
            <Button
                Grid.Column="3"
                Click="ClearLogOutput"
                Style="{StaticResource McgoSecondaryButtonStyle}"
                ToolTipService.ToolTip="清空当前显示">
                <SymbolIcon Symbol="Delete" />
            </Button>
        </Grid>

        <!--  日志区占满剩余高度  -->
        <Border
            Grid.Row="2"
            Style="{StaticResource McgoCardStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="LogStatusText"
                    Style="{StaticResource McgoCardSubtitleStyle}"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="LogOutputBox"
                    Grid.Row="1"
                    Style="{StaticResource McgoLogBoxStyle}"
                    TextWrapping="NoWrap" />
            </Grid>
        </Border>
    </Grid>
</Page>
