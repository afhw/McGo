<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="ResponsiveLayoutRoot" Padding="24,18,24,24" Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="资源" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="从 Modrinth 搜索并安装资源，或管理当前版本的本地资源。" TextWrapping="Wrap" />
            </StackPanel>

            <SelectorBar x:Name="ResourceSectionBar" SelectionChanged="ResourceSectionChanged">
                <SelectorBarItem Text="资源市场" Tag="market" />
                <SelectorBarItem Text="本地资源" Tag="local" />
            </SelectorBar>

            <Border x:Name="ResourceSearchPanel" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="资源市场" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ResourceQueryBox" Header="搜索关键词" PlaceholderText="Mod、资源包、光影或数据包" />
                        <ComboBox x:Name="ResourceVersionBox" Grid.Column="1" Header="安装目标版本" SelectionChanged="ResourceVersionChanged" />
                        <ComboBox x:Name="ResourceSourceBox" Grid.Row="1" Header="来源" SelectedIndex="0" SelectionChanged="ResourceSourceChanged">
                            <ComboBoxItem Content="modrinth" />
                            <ComboBoxItem Content="local" />
                        </ComboBox>
                        <ComboBox x:Name="ResourceTypeBox" Grid.Row="1" Grid.Column="1" Header="类型" SelectedIndex="0" SelectionChanged="ResourceTypeChanged">
                            <ComboBoxItem Content="mod" />
                            <ComboBoxItem Content="resourcepack" />
                            <ComboBoxItem Content="shader" />
                            <ComboBoxItem Content="datapack" />
                        </ComboBox>
                        <TextBox x:Name="ResourceGameVersionBox" Grid.Row="2" Header="游戏版本" />
                        <TextBox x:Name="ResourceLoaderBox" Grid.Row="2" Grid.Column="1" Header="加载器" />
                        <ComboBox x:Name="ResourceSortBox" Grid.Row="3" Header="排序" SelectedIndex="0">
                            <ComboBoxItem Content="relevance" />
                            <ComboBoxItem Content="downloads" />
                            <ComboBoxItem Content="follows" />
                            <ComboBoxItem Content="updated" />
                            <ComboBoxItem Content="newest" />
                        </ComboBox>
                        <Button x:Name="SearchResourcesButton" Grid.Row="3" Grid.Column="1" Content="搜索资源" Click="SearchResources" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>

                <Border x:Name="ResourceResultsPanel" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="搜索结果" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="InstallResourceDependenciesCheckBox" Content="安装 Modrinth 必需依赖" IsChecked="True" />
                        <Grid ColumnSpacing="8" MaxWidth="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="InstallResourceButton" Content="安装选中资源" Click="InstallSelectedResource" HorizontalAlignment="Stretch" />
                            <Button x:Name="ResourceDetailButton" Grid.Column="1" Content="查看详情" Click="ShowSelectedResourceDetail" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock x:Name="ResourceStatusText" Text="等待搜索" TextWrapping="Wrap" />
                        <ProgressBar x:Name="ResourceProgressBar" Minimum="0" Maximum="100" Height="8" />
                        <ListView x:Name="ResourceResultsList" MinHeight="280" />
                    </StackPanel>
                </Border>

                <Border x:Name="LocalResourcesPanel" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="本地资源" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="TargetDirBox" Header="目标目录" />
                        <Grid ColumnSpacing="8" RowSpacing="8" MaxWidth="520" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Content="刷新本地" Click="RefreshLocalResources" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="查看详情" Click="ShowLocalResourceDetail" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Content="启用" Click="EnableLocalResource" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Content="禁用" Click="DisableLocalResource" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="1" Content="删除" Click="DeleteLocalResource" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnSpacing="8" MaxWidth="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResolveDependenciesButton" Content="解析依赖" Click="ResolveDependencies" HorizontalAlignment="Stretch" />
                            <Button x:Name="InstallMissingDependenciesButton" Grid.Column="1" Content="安装缺失前置" Click="InstallMissingDependencies" HorizontalAlignment="Stretch" />
                        </Grid>
                        <ListView x:Name="LocalResourcesList" MinHeight="220" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="资源详情" FontSize="18" FontWeight="SemiBold" />
                    <ListView x:Name="ResourceScreenshotsList" MaxHeight="110" />
                    <TextBox x:Name="ResourceDetailBox" MinHeight="180" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
                </StackPanel>
            </Border>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="操作日志" FontSize="18" FontWeight="SemiBold" />
                    <TextBox x:Name="ResourceOutputBox" MinHeight="180" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
