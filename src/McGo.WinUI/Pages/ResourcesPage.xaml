<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24,16,24,16" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="资源" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="搜索关键词" />
                    <TextBox x:Name="ResourceQueryBox" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="来源" />
                    <ComboBox x:Name="ResourceSourceBox" SelectedIndex="0" SelectionChanged="ResourceSourceChanged">
                        <ComboBoxItem Content="modrinth" />
                        <ComboBoxItem Content="local" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="类型" />
                    <ComboBox x:Name="ResourceTypeBox" SelectedIndex="0">
                        <ComboBoxItem Content="mod" />
                        <ComboBoxItem Content="resourcepack" />
                        <ComboBoxItem Content="shader" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="6">
                    <TextBlock Text="游戏版本" />
                    <TextBox x:Name="ResourceGameVersionBox" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="6">
                    <TextBlock Text="加载器" />
                    <TextBox x:Name="ResourceLoaderBox" />
                </StackPanel>
                <StackPanel Grid.Column="5" Spacing="6">
                    <TextBlock Text="排序" />
                    <ComboBox x:Name="ResourceSortBox" SelectedIndex="0">
                        <ComboBoxItem Content="relevance" />
                        <ComboBoxItem Content="downloads" />
                        <ComboBoxItem Content="follows" />
                        <ComboBoxItem Content="updated" />
                        <ComboBoxItem Content="newest" />
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="6" Content="搜索" Click="SearchResources" VerticalAlignment="Bottom" />
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="10">
                    <TextBlock Text="搜索结果" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox x:Name="InstallResourceDependenciesCheckBox" Content="安装必需依赖" IsChecked="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallResourceButton" Content="安装选中资源" Click="InstallSelectedResource" />
                        <Button x:Name="ResourceDetailButton" Content="查看详情" Click="ShowSelectedResourceDetail" />
                    </StackPanel>
                    <TextBlock x:Name="ResourceStatusText" Text="等待搜索" TextWrapping="Wrap" />
                    <ListView x:Name="ResourceResultsList" MinHeight="280" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="本地资源" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="目标目录" />
                    <TextBox x:Name="TargetDirBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新本地" Click="RefreshLocalResources" />
                        <Button Content="查看详情" Click="ShowLocalResourceDetail" />
                        <Button Content="启用" Click="EnableLocalResource" />
                        <Button Content="禁用" Click="DisableLocalResource" />
                        <Button Content="删除" Click="DeleteLocalResource" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="解析依赖" Click="ResolveDependencies" />
                        <Button Content="安装缺失前置" Click="InstallMissingDependencies" />
                    </StackPanel>
                    <ListView x:Name="LocalResourcesList" MinHeight="220" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="资源详情" FontSize="18" FontWeight="SemiBold" />
                <ListView x:Name="ResourceScreenshotsList" MaxHeight="110" />
                <TextBox x:Name="ResourceDetailBox" MinHeight="180" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
            </StackPanel>

            <TextBox x:Name="ResourceOutputBox" MinHeight="180" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
