<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24,16,24,16" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="启动" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="游戏目录" />
                    <TextBox x:Name="GameDirectoryBox" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Java 路径" />
                    <TextBox x:Name="JavaPathBox" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="账号" />
                    <ComboBox x:Name="AccountComboBox" />
                </StackPanel>
                <Button Grid.Column="3" Content="保存设置" Click="SaveSettings" VerticalAlignment="Bottom" />
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="10">
                    <TextBlock Text="版本分类" />
                    <ComboBox x:Name="VersionCategoryBox" SelectionChanged="VersionCategoryChanged" SelectedIndex="0">
                        <ComboBoxItem Content="全部版本" />
                        <ComboBoxItem Content="收藏" />
                        <ComboBoxItem Content="原版" />
                        <ComboBoxItem Content="仅 OptiFine" />
                        <ComboBoxItem Content="可安装 Mod" />
                        <ComboBoxItem Content="隐藏" />
                    </ComboBox>
                    <Button Content="刷新本地版本" Click="RefreshVersions" />
                    <ListView x:Name="VersionsList" MinHeight="360" SelectionChanged="VersionsList_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="显示名称" />
                            <TextBox x:Name="VersionAliasBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Quick Play 世界" />
                            <TextBox x:Name="QuickPlayBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="5">
                            <TextBlock Text="最大内存 MB" />
                            <TextBox x:Name="MemoryBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                            <TextBlock Text="最小内存 MB" />
                            <TextBox x:Name="MinMemoryBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="5">
                            <TextBlock Text="窗口宽度" />
                            <TextBox x:Name="WindowWidthBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5">
                            <TextBlock Text="窗口高度" />
                            <TextBox x:Name="WindowHeightBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="5">
                            <TextBlock Text="GC 策略" />
                            <ComboBox x:Name="GcStrategyBox" SelectedIndex="0">
                                <ComboBoxItem Content="G1GC" />
                                <ComboBoxItem Content="ZGC" />
                                <ComboBoxItem Content="SerialGC" />
                                <ComboBoxItem Content="None" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="额外 JVM 参数" />
                    <TextBox x:Name="ExtraJvmArgsBox" />
                    <TextBlock Text="额外游戏参数" />
                    <TextBox x:Name="ExtraGameArgsBox" />
                    <TextBlock Text="启动前命令" />
                    <TextBox x:Name="PreLaunchCommandBox" />
                    <TextBlock Text="运行目录" />
                    <TextBox x:Name="RuntimeDirectoryBox" />
                    <TextBlock Text="自定义 Mods 目录" />
                    <TextBox x:Name="CustomModsDirectoryBox" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="UseIsolationCheckBox" Content="版本独立目录" />
                        <CheckBox x:Name="VersionFavoriteCheckBox" Content="收藏当前版本" />
                        <CheckBox x:Name="VersionHiddenCheckBox" Content="隐藏当前版本" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="保存版本设置" Click="SaveVersionSettings" Margin="0,0,8,8" />
                        <Button Content="检测 Java" Click="CheckJavaRuntime" Margin="0,0,8,8" />
                        <Button Content="下载推荐 Java" Click="DownloadRecommendedJava" Margin="0,0,8,8" />
                        <Button Content="生成命令" Click="PreviewCommand" Margin="0,0,8,8" />
                        <Button Content="补全/校验文件" Click="RepairSelectedVersion" Margin="0,0,8,8" />
                        <Button Content="启动游戏" Click="LaunchGame" Margin="0,0,8,8" />
                        <Button Content="导出启动脚本" Click="ExportLaunchScript" Margin="0,0,8,8" />
                        <Button Content="删除版本" Click="DeleteSelectedVersion" Margin="0,0,8,8" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="版本文件夹" Click="OpenVersionFolder" />
                        <Button Content="存档" Click="OpenSavesFolder" />
                        <Button Content="Mods" Click="OpenModsFolder" />
                        <Button Content="资源包" Click="OpenResourcepacksFolder" />
                        <Button Content="光影" Click="OpenShaderpacksFolder" />
                        <Button Content="截图" Click="OpenScreenshotsFolder" />
                    </StackPanel>

                    <TextBox x:Name="OutputBox" MinHeight="180" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
