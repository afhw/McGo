<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer x:Name="HomeScrollViewer" MinWidth="0" MaxWidth="1320" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="ResponsiveLayoutRoot" Padding="24,16,24,28" HorizontalAlignment="Stretch" Spacing="16" SizeChanged="ResponsiveLayoutRoot_SizeChanged">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource McgoPageTitleStyle}" Text="首页" />
                    <TextBlock Style="{StaticResource McgoPageSubtitleStyle}" Text="McGo · 面向 Minecraft 的轻量启动器" />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Click="RefreshStatus" Style="{StaticResource McgoSecondaryButtonStyle}" AutomationProperties.Name="刷新状态" ToolTipService.ToolTip="重新检测版本、账号与 Java">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock x:Name="RefreshStatusLabel" Text="刷新状态" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="HomeContentGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HomePrimaryColumn" Width="1.3*" />
                    <ColumnDefinition x:Name="HomeSecondaryColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Padding="22" VerticalAlignment="Top" Style="{StaticResource McgoHeroCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource McgoIconBadgeStyle}">
                                <SymbolIcon Symbol="Play" Style="{StaticResource McgoIconGlyphStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ReadinessText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Text="正在检查运行环境" />
                                <TextBlock x:Name="LaunchHintText" Style="{StaticResource McgoCardSubtitleStyle}" Text="正在读取本地版本、账号和 Java 状态…" />
                            </StackPanel>
                        </Grid>

                        <!--  三个关键状态压成一行文字，不再用三个胶囊占位  -->
                        <TextBlock
                            x:Name="ChipsSummaryText"
                            Style="{StaticResource McgoCardSubtitleStyle}"
                            TextWrapping="Wrap"
                            Text="未登录账号 · 尚未安装版本 · Java 未识别" />
                        <!--  保留原控件供代码更新，但不占视觉空间  -->
                        <StackPanel Height="0" Opacity="0" Visibility="Collapsed">
                            <TextBlock x:Name="AccountChipText" Text="" />
                            <TextBlock x:Name="FirstVersionText" Text="" />
                            <TextBlock x:Name="JavaChipText" Text="" />
                        </StackPanel>

                        <Grid x:Name="HomeActionsGrid" MaxWidth="460" HorizontalAlignment="Stretch" ColumnSpacing="10" RowSpacing="10" SizeChanged="HomeActionsGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrimaryLaunchButton" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="PrimaryAction" Style="{StaticResource McgoPrimaryButtonStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon x:Name="PrimaryButtonIcon" Symbol="Play" />
                                    <TextBlock x:Name="PrimaryButtonText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="进入启动页" />
                                </Grid>
                            </Button>
                            <Button x:Name="SecondaryLaunchButton" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="SecondaryAction" Style="{StaticResource McgoSecondaryButtonStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon x:Name="SecondaryButtonIcon" Symbol="Library" />
                                    <TextBlock x:Name="SecondaryButtonText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="管理版本" />
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="StatusCard" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource McgoCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="运行环境" />
                        <Grid x:Name="HomeStatsGrid" ColumnSpacing="14" RowSpacing="10" SizeChanged="HomeStatsGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="VersionCountText" Style="{StaticResource McgoStatValueStyle}" Text="0" />
                                <TextBlock Style="{StaticResource McgoStatLabelStyle}" Text="本地版本" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="AccountCountText" Style="{StaticResource McgoStatValueStyle}" Text="0" />
                                <TextBlock Style="{StaticResource McgoStatLabelStyle}" Text="可用账号" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Name="MemoryText" Style="{StaticResource McgoStatValueStyle}" TextWrapping="Wrap" Text="4096 MB" />
                                <TextBlock Style="{StaticResource McgoStatLabelStyle}" Text="推荐内存" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource McgoDividerStyle}" />
                        <Grid ColumnSpacing="10" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource McgoInfoKeyStyle}" Text="游戏目录" />
                            <TextBlock x:Name="GameDirectoryText" Grid.Column="1" Style="{StaticResource McgoInfoValueStyle}" Text=".minecraft" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Text, ElementName=GameDirectoryText}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource McgoInfoKeyStyle}" Text="Java" />
                            <TextBlock x:Name="JavaStatusText" Grid.Row="1" Grid.Column="1" Style="{StaticResource McgoInfoValueStyle}" Text="未检测" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Text, ElementName=JavaStatusText}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource McgoInfoKeyStyle}" Text="版本" />
                            <TextBlock x:Name="VersionHintText" Grid.Row="2" Grid.Column="1" Style="{StaticResource McgoInfoValueStyle}" Text="先下载一个游戏版本" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Text, ElementName=VersionHintText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="QuickLinksCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource McgoCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid x:Name="QuickLinksGrid" ColumnSpacing="10" RowSpacing="10" SizeChanged="QuickLinksGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button MinWidth="0" HorizontalContentAlignment="Stretch" Click="OpenDownload" Style="{StaticResource McgoTileButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="Download" Style="{StaticResource McgoIconGlyphStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock TextWrapping="Wrap" Text="下载版本" />
                                        <TextBlock Style="{StaticResource McgoFieldLabelStyle}" Text="原版、加载器与资源" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" MinWidth="0" HorizontalContentAlignment="Stretch" Click="OpenResources" Style="{StaticResource McgoTileButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="AllApps" Style="{StaticResource McgoIconGlyphStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock TextWrapping="Wrap" Text="资源" />
                                        <TextBlock Style="{StaticResource McgoFieldLabelStyle}" Text="Mod、光影与资源包" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" MinWidth="0" HorizontalContentAlignment="Stretch" Click="OpenOnline" Style="{StaticResource McgoTileButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="Globe" Style="{StaticResource McgoIconGlyphStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock TextWrapping="Wrap" Text="联机" />
                                        <TextBlock Style="{StaticResource McgoFieldLabelStyle}" Text="P2P 与开黑胶囊" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Column="3" MinWidth="0" HorizontalContentAlignment="Stretch" Click="OpenSettings" Style="{StaticResource McgoTileButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="Setting" Style="{StaticResource McgoIconGlyphStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock TextWrapping="Wrap" Text="设置" />
                                        <TextBlock Style="{StaticResource McgoFieldLabelStyle}" Text="目录、主题与更新" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="CustomHomeCard" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource McgoCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="自定义主页" />
                        <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="仅显示本地文件或已允许的联网纯文本内容，在设置里更换来源。" />
                        <TextBox x:Name="SummaryText" MinWidth="0" MaxHeight="320" Style="{StaticResource McgoOutputBoxStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
