<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="ResponsiveLayoutRoot" Padding="24,18,24,24" Spacing="16" SizeChanged="ResponsiveLayoutRoot_SizeChanged">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HomePrimaryColumn.Width" Value="*" />
                            <Setter Target="HomeSecondaryColumn.Width" Value="0" />
                            <Setter Target="CurrentStatusCard.(Grid.Column)" Value="0" />
                            <Setter Target="CurrentStatusCard.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1050" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HomePrimaryColumn.Width" Value="1.2*" />
                            <Setter Target="HomeSecondaryColumn.Width" Value="*" />
                            <Setter Target="CurrentStatusCard.(Grid.Column)" Value="1" />
                            <Setter Target="CurrentStatusCard.(Grid.Row)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="McGo" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="一个 Fluent 风格的 Minecraft 启动器" />
            </StackPanel>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HomePrimaryColumn" Width="1.2*" />
                    <ColumnDefinition x:Name="HomeSecondaryColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="开始使用" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按顺序完成账号、环境、下载和启动，更容易定位问题。" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="8" RowSpacing="8" MaxWidth="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Content="1. 管理账号与环境" Click="OpenManage" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="2. 下载版本" Click="OpenDownload" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Content="3. 启动游戏" Click="OpenLaunch" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="1" Content="联机" Click="OpenOnline" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="CurrentStatusCard" Grid.Column="1" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="当前状态" FontSize="20" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="88" />
                                <ColumnDefinition Width="*" MinWidth="72" />
                                <ColumnDefinition Width="1.25*" MinWidth="132" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="本地版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                                <TextBlock x:Name="VersionCountText" FontSize="28" FontWeight="SemiBold" Text="0" TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="账号" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                                <TextBlock x:Name="AccountCountText" FontSize="28" FontWeight="SemiBold" Text="0" TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="推荐内存" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                                <TextBlock x:Name="MemoryText" FontSize="28" FontWeight="SemiBold" Text="4096 MB" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CurrentAccountText" Text="当前账号：未选择" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="JavaStatusText" Text="Java：未检测" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="GameDirectoryText" Text="游戏目录：.minecraft" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Content="刷新状态" Click="RefreshStatus" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="CustomHomeCard" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="自定义主页" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="仅显示本地文件或已允许的联网纯文本内容。" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
