<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="ResponsiveLayoutRoot" Padding="24,18,24,24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="账号操作" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="先选择账号目的，再进入对应账号方式。" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="账号任务" FontSize="18" FontWeight="SemiBold" />
                <SelectorBar x:Name="LoginModeBox" SelectionChanged="LoginModeChanged">
                    <SelectorBarItem Text="当前账号" Tag="overview" />
                    <SelectorBarItem Text="离线账号" Tag="offline" />
                    <SelectorBarItem Text="Microsoft" Tag="microsoft" />
                    <SelectorBarItem Text="外置登录" Tag="external" />
                </SelectorBar>
            </StackPanel>

            <Grid>
                <Border x:Name="CurrentAccountCard" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="当前账号" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentAccountStatusText" Text="当前账号：未选择" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ComboBox x:Name="CurrentAccountBox" Header="当前使用账号" SelectionChanged="CurrentAccountSelectionChanged" HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="DeleteAccountBox" Header="准备删除的账号" SelectionChanged="DeleteAccountSelectionChanged" HorizontalAlignment="Stretch" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="刷新账号列表" Click="RefreshAccounts" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="刷新选中账号" Click="RefreshSelectedAccount" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Button Content="删除选中账号" Click="DeleteSelectedAccount" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="AccountEditors" Spacing="14" Visibility="Collapsed">
                    <Border x:Name="OfflineAccountCard" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Text="离线账号" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="OfflineNameBox" Header="用户名" />
                                <TextBox x:Name="OfflineUuidBox" Grid.Column="1" Header="UUID（可留空）" />
                                <PasswordBox x:Name="OfflineAccessTokenBox" Grid.Row="1" Grid.ColumnSpan="2" Header="访问令牌（高级，可留空）" />
                            </Grid>
                            <Button Content="添加/更新离线账号" Click="AddOfflineAccount" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="MicrosoftAccountCard" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Microsoft 登录" FontSize="18" FontWeight="SemiBold" />
                            <CheckBox x:Name="AutoOpenBrowserCheckBox" Content="生成登录链接后自动打开浏览器" />
                            <TextBox x:Name="MicrosoftLoginLinkBox" Header="登录链接" PlaceholderText="关闭自动打开后，Microsoft 登录链接会显示在这里" IsReadOnly="True" TextWrapping="NoWrap" />
                            <Grid ColumnSpacing="8" RowSpacing="8" MaxWidth="620" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Content="添加 Microsoft 账号" Click="StartMicrosoftLogin" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="生成登录链接" Click="GenerateMicrosoftLogin" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Content="复制登录链接" Click="CopyMicrosoftLogin" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Content="打开浏览器" Click="OpenMicrosoftLogin" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="1" Content="等待回调并登录" Click="WaitMicrosoftCallback" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBox x:Name="MicrosoftOutputBox" MinHeight="82" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ExternalAccountCard" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="外置登录" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="ExternalServerBox" Header="认证服务器" TextChanged="ExternalFormChanged" />
                                <TextBox x:Name="ExternalUsernameBox" Grid.Column="1" Header="用户名" TextChanged="ExternalFormChanged" />
                                <PasswordBox x:Name="ExternalPasswordBox" Grid.Row="1" Header="密码" />
                                <TextBox x:Name="AuthlibPathBox" Grid.Row="1" Grid.Column="1" Header="authlib-injector.jar 路径" TextChanged="ExternalFormChanged" />
                            </Grid>
                            <TextBlock x:Name="ExternalStatusText" Text="外置登录未连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8" RowSpacing="8" MaxWidth="560" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Content="规范化地址" Click="NormalizeExternalServer" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="测试服务器" Click="ProbeExternalServer" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Content="选择 Jar" Click="ChooseAuthlibInjector" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="1" Content="自动下载" Click="DownloadAuthlibInjector" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="2" Content="刷新/验证当前外置账号" Click="RefreshSelectedAccount" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="2" Grid.Column="1" Content="登录并添加外置账号" Click="LoginExternalAccount" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="3" Content="生成 JVM 参数" Click="PreviewAuthlibArgs" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Text="账号状态" FontSize="18" FontWeight="SemiBold" />
                            <TextBox x:Name="OutputBox" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
