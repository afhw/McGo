<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24,18,24,24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="下载游戏" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择版本类型、镜像源、目标版本和模组适配。" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="选择下载目的" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="旧版 McGo 先从任务目的开始：获取游戏、导入内容或查看任务。" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="获取游戏" Click="StayOnDownloads" />
                        <Button Content="资源市场" Click="OpenResources" />
                        <Button Content="整合包" Click="OpenModpacks" />
                        <Button Content="任务管理" Click="StayOnDownloads" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="下载原版 + 模组适配" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择原版后可一并安装 Fabric、Forge、NeoForge、OptiFine 和 Fabric API。" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox x:Name="GameDirectoryBox" Header="游戏目录" />
                            <TextBox x:Name="JavaPathBox" Grid.Column="1" Header="Java 路径" />
                            <ComboBox x:Name="MirrorBox" Grid.Row="1" Header="下载源" SelectedIndex="0">
                                <ComboBoxItem Content="official" />
                                <ComboBoxItem Content="bmclapi" />
                            </ComboBox>
                            <ComboBox x:Name="VersionTypeBox" Grid.Row="1" Grid.Column="1" Header="版本类型" SelectedIndex="0">
                                <ComboBoxItem Content="release" />
                                <ComboBoxItem Content="snapshot" />
                                <ComboBoxItem Content="old_beta" />
                                <ComboBoxItem Content="old_alpha" />
                            </ComboBox>
                            <ComboBox x:Name="RemoteVersionsBox" Grid.Row="2" Header="远程版本" />
                            <Button Grid.Row="2" Grid.Column="1" Content="刷新远程" Click="RefreshRemoteVersions" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                        </Grid>

                        <ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox x:Name="IncludeAssetsCheckBox" Content="包含 assets" IsChecked="True" />
                                <CheckBox x:Name="InstallFabricCheckBox" Content="Fabric" />
                                <CheckBox x:Name="InstallForgeCheckBox" Content="Forge" />
                                <CheckBox x:Name="InstallNeoForgeCheckBox" Content="NeoForge" />
                                <CheckBox x:Name="InstallFabricApiCheckBox" Content="Fabric API" />
                                <CheckBox x:Name="InstallOptifineCheckBox" Content="OptiFine" />
                            </StackPanel>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DownloadButton" Content="下载所选版本" Click="DownloadSelectedVersion" />
                            <Button x:Name="CancelTaskButton" Content="取消当前任务" Click="CancelCurrentTask" IsEnabled="False" />
                            <Button x:Name="RetryTaskButton" Content="重试失败任务" Click="RetryFailedTask" IsEnabled="False" />
                            <Button x:Name="ClearQueueButton" Content="清空等待队列" Click="ClearDownloadQueue" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Text="任务进度" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentTaskText" Text="当前任务：无" TextWrapping="Wrap" />
                            <TextBlock x:Name="TaskQueueText" Text="队列：0 | 下一个：无" TextWrapping="Wrap" />
                            <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="8" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Text="统一下载任务" FontSize="18" FontWeight="SemiBold" />
                            <TextBox x:Name="TaskRecordsBox" MinHeight="140" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Text="暂无下载任务" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="状态日志" FontSize="18" FontWeight="SemiBold" />
                    <TextBox x:Name="DownloadLogBox" MinHeight="220" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
