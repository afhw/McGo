<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="NumberBox">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <DataTemplate x:Key="SettingsToggleHeaderTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
        <Style TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate" Value="{StaticResource SettingsToggleHeaderTemplate}" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            x:Name="SettingsLayoutRoot"
            MinWidth="0"
            MaxWidth="960"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalContentAlignment="Top"
            SizeChanged="SettingsLayoutRoot_SizeChanged">
            <StackPanel
                x:Name="SettingsContentRoot"
                HorizontalAlignment="Stretch"
                Padding="24,16,24,28"
                Spacing="16">

            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource McgoPageTitleStyle}" Text="设置" />
            </StackPanel>

            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <SelectorBar
                x:Name="SettingsSectionBar"
                HorizontalAlignment="Left"
                SelectionChanged="SettingsSectionChanged">
                <SelectorBarItem Text="环境" Tag="environment" />
                <SelectorBarItem Text="下载" Tag="download" />
                <SelectorBarItem Text="外观与功能" Tag="appearance" />
                <SelectorBarItem Text="音乐" Tag="music" />
                <SelectorBarItem Text="更新" Tag="update" />
            </SelectorBar>
            </ScrollViewer>

            <Border x:Name="EnvironmentSettingsPanel" Style="{StaticResource McgoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="环境与目录" />
                        <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="Minecraft 数据目录和默认 Java 运行时。" />
                    </StackPanel>
                    <Grid x:Name="GameDirectoryPickerGrid" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="GameDirectoriesBox" Header="保存的目录" SelectionChanged="GameDirectorySelectionChanged"
                                  ToolTipService.ToolTip="{Binding SelectedItem.Path, ElementName=GameDirectoriesBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <Button x:Name="AddGameDirectoryButton" Width="36" Height="36" MinWidth="0" Padding="0"
                                    Click="ChooseGameDirectory" ToolTipService.ToolTip="添加目录并选中（保存后生效）"
                                    AutomationProperties.Name="添加游戏目录" Style="{StaticResource McgoSecondaryButtonStyle}">
                                <SymbolIcon Symbol="Add" />
                            </Button>
                            <Button x:Name="RenameGameDirectoryButton" Width="36" Height="36" MinWidth="0" Padding="0"
                                    Click="RenameGameDirectory" ToolTipService.ToolTip="应用显示名称（保存后生效）"
                                    AutomationProperties.Name="重命名游戏目录" Style="{StaticResource McgoSecondaryButtonStyle}">
                                <SymbolIcon Symbol="Rename" />
                            </Button>
                            <Button x:Name="RemoveGameDirectoryButton" Width="36" Height="36" MinWidth="0" Padding="0"
                                    Click="RemoveGameDirectory" ToolTipService.ToolTip="移除目录记录，不删除文件（至少保留一项）"
                                    AutomationProperties.Name="移除游戏目录记录" Style="{StaticResource McgoSecondaryButtonStyle}">
                                <SymbolIcon Symbol="Remove" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="GameDirectoryNameBox" Header="目录显示名称" TextChanged="GameDirectoryDetailsChanged" />
                    <TextBox x:Name="GameDirectoryBox" Header="目录路径" TextChanged="GameDirectoryDetailsChanged" />
                    <TextBlock Text="目录变更将在保存全部设置后生效；移除仅删除记录，不删除文件。"
                               TextWrapping="Wrap" Style="{StaticResource McgoCardSubtitleStyle}" />
                    <ToggleSwitch x:Name="AutoJavaToggleSwitch" Header="自动选择适合版本的 Java"
                                  Toggled="AutoJavaChanged" />
                    <Grid x:Name="JavaPathPickerGrid" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="JavaPathBox" Header="Java 路径" />
                        <Button x:Name="ChooseJavaButton" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseJavaFile" Content="选择文件" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    </Grid>
                    <Grid x:Name="JavaCandidatesPickerGrid" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="JavaCandidatesBox" HorizontalAlignment="Stretch" Header="检测到的 Java" SelectionChanged="JavaCandidateChanged"
                                  ToolTipService.ToolTip="{Binding SelectedItem, ElementName=JavaCandidatesBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshJavaCandidates" Content="重新检测" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="DownloadSettingsPanel" Style="{StaticResource McgoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="下载参数" />
                        <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="镜像、缓存、并发和可选的 Modrinth 自定义地址。" />
                    </StackPanel>
                    <Grid x:Name="DownloadOptionsGrid" ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="MirrorBox" Header="镜像源">
                            <ComboBoxItem Content="官方源" Tag="official" />
                            <ComboBoxItem Content="BMCLAPI" Tag="bmclapi" />
                        </ComboBox>
                        <ComboBox x:Name="CacheStrategyBox" Grid.Column="1" Header="缓存策略">
                            <ComboBoxItem Content="复用缓存" Tag="reuse" />
                            <ComboBoxItem Content="校验后复用" Tag="verify" />
                            <ComboBoxItem Content="总是下载" Tag="redownload" />
                        </ComboBox>
                    </Grid>
                    <NumberBox x:Name="SpeedLimitBox" Header="限速 KB/s（0 为不限）" LargeChange="1024" Maximum="1048576" Minimum="0" SmallChange="256" SpinButtonPlacementMode="Compact" />
                    <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Spacing="1">
                                <TextBlock Text="高级：并发与自定义地址" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource McgoStatLabelStyle}" Text="一般不需要改" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <Grid x:Name="ConcurrencyGrid" ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="CoreThreadsBox" Header="核心文件并发" LargeChange="4" Maximum="64" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="AssetThreadsBox" Grid.Column="1" Header="资源文件并发" LargeChange="8" Maximum="96" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <TextBox x:Name="ModrinthApiBaseBox" Header="Modrinth API Base" PlaceholderText="留空使用官方地址" />
                            <TextBox x:Name="ModrinthCdnBaseBox" Header="Modrinth CDN Base" PlaceholderText="留空不重写下载地址" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border x:Name="AppearanceSettingsPanel" Style="{StaticResource McgoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="个性化与功能" />
                        <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="主题、主页内容和可见功能集中在这里。" />
                    </StackPanel>
                    <Grid x:Name="ThemePickerGrid" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ThemeBox" Header="界面主题">
                            <ComboBoxItem Content="深色" Tag="dark" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="跟随系统" Tag="auto" />
                        </ComboBox>
                        <TextBox x:Name="ThemeImageBox" Grid.Column="1" Header="主题背景图" />
                        <Button Grid.Column="2" VerticalAlignment="Bottom" Click="ChooseThemeImageFile" Content="选择" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    </Grid>
                    <Grid x:Name="HomeContentPickerGrid" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HomeContentSourceBox" Header="主页内容源" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseHomeContentFile" Content="选择" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    </Grid>
                    <Grid x:Name="FeatureOptionsGrid" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleSwitch x:Name="HomeNetworkToggleSwitch" Header="允许联网主页" />
                        <ToggleSwitch x:Name="AdvancedModeToggleSwitch" Grid.Column="1" Toggled="AdvancedModeChanged" Header="显示高级选项" />
                        <ToggleSwitch x:Name="ResourceIsolationToggleSwitch" Grid.Row="1" Header="启用版本资源隔离" />
                        <ToggleSwitch x:Name="ShowDownloadToggleSwitch" Grid.Row="1" Grid.Column="1" Header="显示下载页" />
                    </Grid>
                    <Button HorizontalAlignment="Left" Click="RefreshHomeContent" Content="刷新主页预览" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    <TextBox x:Name="HomePreviewBox" MinWidth="0" MinHeight="150" Style="{StaticResource McgoOutputBoxStyle}" />
                </StackPanel>
            </Border>

            <Border x:Name="MusicSettingsPanel" Style="{StaticResource McgoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="背景音乐" />
                        <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="选择本地音乐并控制启动游戏后的播放行为。" />
                    </StackPanel>
                    <Grid x:Name="MusicPickerGrid" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MusicPathBox" Header="音乐文件" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseMusicFile" Content="选择" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    </Grid>
                    <Grid x:Name="MusicOptionsGrid" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="MusicEnabledToggleSwitch" Header="启用背景音乐" />
                        <ToggleSwitch x:Name="MusicPauseOnLaunchToggleSwitch" Grid.Column="1" Header="启动游戏后暂停" />
                    </Grid>
                    <NumberBox x:Name="MusicVolumeBox" Header="音量 %" LargeChange="10" Maximum="100" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact" />
                    <Grid x:Name="MusicActionsGrid" ColumnSpacing="8" RowSpacing="8" MaxWidth="360" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Click="ApplyMusicSettings" Content="播放 / 应用" Style="{StaticResource McgoPrimaryButtonStyle}" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="StopMusic" Content="停止音乐" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="UpdateSettingsPanel" Style="{StaticResource McgoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="McGo 更新" />
                        <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="检查更新清单，下载并应用新版本。" />
                    </StackPanel>
                    <ToggleSwitch x:Name="UpdateAutoCheckToggleSwitch" Header="启动时自动检查更新" />
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource McgoCardSubtitleStyle}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgressBar" Height="6" Maximum="100" Minimum="0" />
                    <Grid x:Name="UpdateActionsGrid" ColumnSpacing="8" RowSpacing="8" MaxWidth="540" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Click="CheckUpdates" Content="检查更新" Style="{StaticResource McgoPrimaryButtonStyle}" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="DownloadUpdate" Content="下载更新" Style="{StaticResource McgoSecondaryButtonStyle}" />
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="ApplyDownloadedUpdate" Content="应用更新" Style="{StaticResource McgoSecondaryButtonStyle}" />
                    </Grid>
                    <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock FontSize="13" Text="更新源与详情" />
                        </Expander.Header>
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <TextBox x:Name="UpdateManifestBox" Header="更新清单 URL" />
                            <TextBox x:Name="UpdateOutputBox" MinWidth="0" MaxHeight="220" MinHeight="120" Style="{StaticResource McgoLogBoxStyle}" TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  保存条常驻底部，随时可点  -->
        <Border
            Grid.Row="1"
            Padding="0,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid x:Name="SettingsSaveGrid" ColumnSpacing="12" RowSpacing="8" MaxWidth="960" Padding="24,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource McgoCardSubtitleStyle}"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{Binding Text, ElementName=StatusText}"
                    TextWrapping="Wrap" />
                <Button x:Name="SaveAllButton" Grid.Column="1" MinWidth="0" Click="SaveSettings" Style="{StaticResource McgoPrimaryButtonStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="保存全部设置" />
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
