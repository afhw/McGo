<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24,16,24,16" Spacing="18">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="基础路径" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GameDirectoryBox" Header="游戏目录" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="ChooseGameDirectory" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="JavaPathBox" Header="Java 路径" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="ChooseJavaFile" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="下载" />
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="MirrorBox" Header="镜像源" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="官方源" Tag="official" />
                        <ComboBoxItem Content="BMCLAPI" Tag="bmclapi" />
                    </ComboBox>
                    <ComboBox x:Name="CacheStrategyBox" Grid.Column="1" Header="缓存策略" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="复用缓存" Tag="reuse" />
                        <ComboBoxItem Content="校验后复用" Tag="verify" />
                        <ComboBoxItem Content="总是下载" Tag="redownload" />
                    </ComboBox>

                    <TextBox x:Name="CoreThreadsBox" Grid.Row="1" Header="核心文件并发" InputScope="Number" />
                    <TextBox x:Name="AssetThreadsBox" Grid.Row="1" Grid.Column="1" Header="资源文件并发" InputScope="Number" />
                    <TextBox x:Name="SpeedLimitBox" Grid.Row="2" Header="限速 KB/s（0 为不限）" InputScope="Number" />
                    <TextBox x:Name="ModrinthApiBaseBox" Grid.Row="2" Grid.Column="1" Header="Modrinth API Base" />
                </Grid>
                <TextBox x:Name="ModrinthCdnBaseBox" Header="Modrinth CDN Base" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="外观和主页" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ThemeBox" Header="界面主题" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="深色" Tag="dark" />
                        <ComboBoxItem Content="浅色" Tag="light" />
                        <ComboBoxItem Content="跟随系统" Tag="auto" />
                    </ComboBox>
                    <TextBox x:Name="ThemeImageBox" Grid.Column="1" Header="主题背景图" />
                    <Button Grid.Column="2" VerticalAlignment="Bottom" Content="选择" Click="ChooseThemeImageFile" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HomeContentSourceBox" Header="主页内容源" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="ChooseHomeContentFile" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="HomeNetworkCheckBox" Content="允许联网主页" />
                    <Button Content="刷新主页预览" Click="RefreshHomeContent" />
                </StackPanel>
                <TextBox x:Name="HomePreviewBox" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="背景音乐" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MusicPathBox" Header="音乐文件" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="ChooseMusicFile" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="MusicEnabledBox" Content="启用背景音乐" />
                    <CheckBox x:Name="MusicPauseOnLaunchBox" Content="启动游戏后暂停" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="音量" />
                    <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="应用音乐" Click="ApplyMusicSettings" />
                    <Button Content="停止音乐" Click="StopMusic" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="更新" />
                <TextBox x:Name="UpdateManifestBox" Header="更新清单 URL" />
                <CheckBox x:Name="UpdateAutoCheckBox" Content="启动时自动检查更新" />
                <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="检查更新" Click="CheckUpdates" />
                    <Button Content="下载更新" Click="DownloadUpdate" />
                    <Button Content="应用更新" Click="ApplyDownloadedUpdate" />
                </StackPanel>
                <TextBox x:Name="UpdateOutputBox" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="保存全部设置" Click="SaveSettings" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
