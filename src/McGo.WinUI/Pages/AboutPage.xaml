<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="McGo.WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel
            MaxWidth="960"
            HorizontalAlignment="Stretch"
            Padding="24,16,24,28"
            Spacing="16">

            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource McgoPageTitleStyle}" Text="关于" />
                <TextBlock Style="{StaticResource McgoPageSubtitleStyle}" Text="目录说明、使用提示和项目来源。" />
            </StackPanel>

            <Border Style="{StaticResource McgoHeroCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource McgoIconBadgeStyle}">
                        <SymbolIcon Symbol="Help" Style="{StaticResource McgoIconGlyphStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="McGo" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource McgoCardSubtitleStyle}" Text="版本" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource McgoCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="目录说明" />
                    <Grid ColumnSpacing="10" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource McgoInfoKeyStyle}" Text="versions" />
                        <TextBlock Grid.Column="1" Style="{StaticResource McgoInfoValueStyle}" Text="版本清单与客户端 jar" />
                        <TextBlock Grid.Row="1" Style="{StaticResource McgoInfoKeyStyle}" Text="libraries" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource McgoInfoValueStyle}" Text="依赖库" />
                        <TextBlock Grid.Row="2" Style="{StaticResource McgoInfoKeyStyle}" Text="assets" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource McgoInfoValueStyle}" Text="资源文件" />
                        <TextBlock Grid.Row="3" Style="{StaticResource McgoInfoKeyStyle}" Text="隔离目录" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource McgoInfoValueStyle}" Text="存放到 versions/&lt;版本名&gt;/（存档、Mod、资源包、光影、截图）" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource McgoCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource McgoCardTitleStyle}" Text="致谢" />
                    <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="Mojang 版本元数据、BMCLAPI、Modrinth、authlib-injector 和 Windows App SDK。" />
                     <TextBlock Style="{StaticResource McgoCardSubtitleStyle}" Text="界面布局参考了 Plain Craft Launcher（PCL）的信息层级：主操作在前，状态与设置在后。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>